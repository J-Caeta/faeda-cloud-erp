function limparDuplicatasDireto() {
  const planilha = SpreadsheetApp.getActiveSpreadsheet();
  const aba = planilha.getActiveSheet(); // Roda na aba que você estiver olhando
  
  const dados = aba.getDataRange().getValues();
  if (dados.length < 2) return; // Se só tiver cabeçalho, não faz nada

  const linhasParaManter = [];
  const assinaturasVistas = new Set();
  let duplicadasCount = 0;

  // Adiciona o cabeçalho (Linha 1) na lista final
  linhasParaManter.push(dados[0]);

  // Começa a varredura da linha 2 em diante
  for (let i = 1; i < dados.length; i++) {
    const linha = dados[i];
    
    // --- DEFINIÇÃO DO QUE É DUPLICATA ---
    // Índices (começa em 0): 
    // Coluna B (Data) = 1
    // Coluna C (ID_Aluno) = 2
    // Coluna G (Valor) = 6
    // Ajuste os números abaixo se suas colunas mudaram de lugar!
    
    const dataPagamento = linha[1]; 
    const idAluno = linha[2];       
    const valor = linha[6];         
    
    // Converte data para texto simples para poder comparar
    const dataString = (dataPagamento instanceof Date) ? dataPagamento.toDateString() : dataPagamento;

    // Cria a "Assinatura Única" desse pagamento
    const assinatura = `${idAluno}|${dataString}|${valor}`; 

    if (!assinaturasVistas.has(assinatura)) {
      // Se é inédito, salva
      assinaturasVistas.add(assinatura);
      linhasParaManter.push(linha);
    } else {
      // Se já existe essa assinatura, é duplicata e será ignorado
      duplicadasCount++;
    }
  }

  // Se houve limpeza, reescreve a aba
  if (duplicadasCount > 0) {
    aba.getDataRange().clearContent();
    aba.getRange(1, 1, linhasParaManter.length, linhasParaManter[0].length).setValues(linhasParaManter);
    
    // Aviso discreto no canto da tela (Toast)
    planilha.toast(`Pronto! ${duplicadasCount} duplicatas apagadas.`, "Limpeza Concluída");
  } else {
    planilha.toast("Tudo limpo! Nenhuma duplicata encontrada.", "Sucesso");
  }
}